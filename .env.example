# ==============================================================================
# BOOKLOOP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Local SQLite fallback: sqlite:///bookloop.db
# Production PostgreSQL example: postgresql://username:password@hostname:5432/bookloop
DATABASE_URL=sqlite:///bookloop.db

# Cloudinary Storage (Required for Production Image Hosting)
# Leave blank for local fallback storage during development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Initialization Defaults (used by `flask create-admin` CLI command)
# NOTE: In production, default or weak passwords are automatically rejected.
ADMIN_EMAIL=admin@bookloop.edu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password-at-least-12-chars
